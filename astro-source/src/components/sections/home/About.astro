---
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";
import Container from "../../elements/Container.astro";
import Link from "../../elements/Link.astro";
---

<Container variant={'xl'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">About</Heading>
    <div class="flex lg:flex-row lg:gap-16 gap-10 flex-col">
        <div class="flex flex-col items-start gap-6 lg:pt-6 text-base-900 lg:flex-1">
            <Text variant={'xl'}>I work with people — carefully, calmly, and with accurate records.</Text>
            <Text variant={'sm'}>I came to New Zealand for a Graduate Diploma in Supply Chain &amp; Logistics at Ara Institute of Canterbury. From Distinction Hotel to caregiving in Nelson and Christchurch, then support work with IDEA Services and Te Whare Ngakau Trust, each role deepened how I listen, document, and help people take the next practical step.</Text>
            <Text variant={'sm'}>I am based in Kaikōura now and will soon return to Christchurch as a Case Manager at Work and Income. Longer term, I want to work as an Employment Case Manager and grow into leadership.</Text>
            <Link variant={'button'} href="/about">More about me</Link>
        </div>
        <div class="w-full lg:flex-1 flex flex-col gap-4 border-2 border-base-900 p-6 text-base-900">
            <Text variant={'md'}>Languages</Text>
            <Text variant={'sm'} class="text-base-900">Malayalam · Hindi · Tamil · English</Text>
            <Text variant={'md'} class="mt-4">Credentials</Text>
            <Text variant={'sm'} class="text-base-900">Full NZ driver’s licence · First Aid (available to renew)</Text>
            <Text variant={'md'} class="mt-4">Recognition</Text>
            <Text variant={'sm'} class="text-base-900">COVID-19 Response Recognition Award — New Zealand Government</Text>
            <Link variant={'inline'} href="/recognition" class="mt-2">View recognition</Link>
        </div>
    </div>
</Container>
