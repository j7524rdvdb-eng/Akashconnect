---
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";
import ResumeDropdown from "../../elements/ResumeDropdown.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";

const jobs = [
  { title: "Case Manager · Work and Income", place: "Kaikōura", period: "Current", text: "I am currently working as a Case Manager in Kaikōura at Work and Income." },
  { title: "Support Worker · Te Whare Ngakau Trust", place: "Christchurch", period: "Support work", text: "Higher-complexity caseload with intensive support needs. Needs assessment and person-centred support plans. Coordination with clients, clinical teams, and external providers. Accurate confidential records and steady follow-through." },
  { title: "Support Worker · IDEA Services", place: "New Zealand", period: "Support work", text: "Person-centred planning and referrals to specialist services. Trusted working relationships with clients and providers. Confidential records under organisational policy and privacy expectations. Support toward greater independence." },
  { title: "Caregiver · Christchurch", place: "Christchurch", period: "Care", text: "Direct care focused on dignity and quality of daily living. Consistent, reliable support for people and families." },
  { title: "Caregiver · Nelson", place: "Nelson", period: "Care", text: "Moved to Nelson for a caregiving opportunity. Hands-on support in a new community and team setting." },
  { title: "Front Office & Kitchen · Distinction Hotel", place: "Christchurch", period: "Hospitality", text: "Started as a kitchen hand, then moved into front office. Guest service, payments, accurate guest records, and complaint resolution. Reliable performance in a fast-paced team environment." },
]
---

<Container variant={'xl'} class="text-center text-base-900 flex flex-col items-center">
    <Heading tagName="h1" tagSize="h1">Experience</Heading>
    <div class="max-w-3xl flex flex-col gap-4 mb-10">
        <Text variant={'xl'}>Roles and employers</Text>
        <Text variant={'sm'}>What I have done in each chapter of my New Zealand career.</Text>
    </div>
</Container>
<Container variant={'md'}>
    <div class="flex flex-col gap-4">
        <Container class="flex flex-col gap-4 p-6 border-3 border-base-900">
            {jobs.map((i) => (
                <ResumeDropdown title={i.title} place={i.place} period={i.period} text={i.text} />
            ))}
        </Container>
        <ContainerBottom />
    </div>
</Container>
